# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.full.yml — stack completa (Postgres + API + Web + Nginx)
# ─────────────────────────────────────────────────────────────────────────────
# cp .env.full.example .env.full
# Edite os valores marcados com  <-- OBRIGATÓRIO
# docker compose -f docker-compose.full.yml --env-file .env.full up -d --build

# ─── Banco de Dados ───────────────────────────────────────────────────────────
POSTGRES_USER=botchef
POSTGRES_PASSWORD=troque-por-senha-forte          # <-- OBRIGATÓRIO
POSTGRES_DB=botchef

# ─── API (Fastify) ────────────────────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-forte-minimo-32-chars  # <-- OBRIGATÓRIO

# URL pública — usada para registrar webhook no Uazapi.
# localhost  → API_PUBLIC_URL=http://localhost/api
# Servidor   → API_PUBLIC_URL=http://SEU_IP_OU_DOMINIO/api
API_PUBLIC_URL=http://localhost/api

# URL do painel (usada no CORS da API).
# localhost  → WEB_URL=http://localhost
# Servidor   → WEB_URL=http://SEU_IP_OU_DOMINIO
WEB_URL=http://localhost

# ─── Uazapi ───────────────────────────────────────────────────────────────────
UAZAPI_BASE_URL=https://api.uazapi.dev
UAZAPI_GLOBAL_TOKEN=                              # <-- OBRIGATÓRIO

# ─── Nginx ────────────────────────────────────────────────────────────────────
# Porta local onde o nginx vai escutar (padrão 80)
NGINX_PORT=80
