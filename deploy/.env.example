# Copie para ~/botchef/.env NO SERVIDOR e preencha. Nunca commitar o .env real.
#
# Atenção ao caractere $ nos valores: o docker compose interpreta $ como
# variável. Use $$ para um $ literal, ou evite $ nas senhas daqui.

# --- Banco (PostgreSQL deste compose) -----------------------------------------
# O DATABASE_URL é montado pelo compose a partir destes três; não defina aqui.
POSTGRES_USER=botchef
# Gere com: openssl rand -hex 24  (sem caracteres especiais: entra na URL)
POSTGRES_PASSWORD=
POSTGRES_DB=botchef

# --- API ---------------------------------------------------------------------
# Segredo do JWT do painel, mínimo 32 caracteres. Na virada do Windows, use o
# mesmo valor de lá para ninguém ser deslogado (o token vale 7 dias).
JWT_SECRET=
# URL pública da API, COM o prefixo /botchef do Caddy do MenuChef. O webhook
# registrado no Uazapi ao criar uma instância é ${API_PUBLIC_URL}/webhooks/uazapi.
API_PUBLIC_URL=https://api-menuchef.devalltech.com.br/botchef
# Origem liberada no CORS: o painel do BotChef na Vercel. Do outro lado, o
# painel precisa de NEXT_PUBLIC_API_URL=<a mesma URL do API_PUBLIC_URL> no
# projeto da Vercel (e um redeploy: a variável entra no build).
WEB_URL=https://bot.menuchef.com.br

# --- Uazapi ------------------------------------------------------------------
UAZAPI_BASE_URL=
UAZAPI_GLOBAL_TOKEN=

# --- MenuChef (integração) ---------------------------------------------------
# Pela rede interna do Docker, sem passar pela internet. `api` é o serviço da
# API no compose do MenuChef.
MENUCHEF_BASE_URL=http://api:3000
# Mesmo valor de BOTCHEF_SECRET no .env do MenuChef. Mínimo 32 caracteres.
MENUCHEF_BOTCHEF_SECRET=
# Rede do compose do MenuChef em que a API entra (o compose de lá fixa este nome).
MENUCHEF_NETWORK=menuchef_default

# --- Versão da imagem ----------------------------------------------------------
# Tag da imagem botchef-api carregada com `docker load` (commit curto).
BOTCHEF_API_TAG=latest
