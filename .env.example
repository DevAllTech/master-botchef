# ─────────────────────────────────────────────────────────────────────────────
# Banco de Dados
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://botchef:botchef@localhost:5432/botchef"

# Credenciais usadas pelo docker-compose.prod.yml para criar o container Postgres
POSTGRES_USER=botchef
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=botchef

# ─────────────────────────────────────────────────────────────────────────────
# API (Fastify)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET="troque-por-um-segredo-forte-com-32-caracteres-minimo"
API_PORT=3001
API_HOST="0.0.0.0"

# URL pública da API (usada para registrar o webhook no Uazapi + CORS)
API_PUBLIC_URL="https://api.seu-dominio.com"

# Origem permitida no CORS (URL do projeto no Vercel)
WEB_URL="https://seu-projeto.vercel.app"

# ─────────────────────────────────────────────────────────────────────────────
# Uazapi
# ─────────────────────────────────────────────────────────────────────────────
UAZAPI_BASE_URL="https://api.uazapi.dev"
UAZAPI_GLOBAL_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# MenuChef (integração)
# ─────────────────────────────────────────────────────────────────────────────
MENUCHEF_BASE_URL="https://api.menuchef.com"
# Segredo compartilhado entre BotChef e MenuChef — mínimo 32 caracteres
# Deve ser o mesmo valor que BOTCHEF_SECRET no MenuChef
MENUCHEF_BOTCHEF_SECRET="troque-por-segredo-compartilhado-minimo-32-chars"

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js — configurar no painel do Vercel em produção)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Em produção no Vercel: NEXT_PUBLIC_API_URL="https://api.seu-dominio.com"
